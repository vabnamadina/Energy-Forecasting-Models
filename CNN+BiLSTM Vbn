{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":19824294}],"dockerImageVersionId":28755,"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# =============================================================================\n#  PGCB HOURLY LOAD FORECASTING\n#  CNN + BiLSTM + Ensemble + Prediction Interval\n# =============================================================================\n#  SAME data pipeline / feature engineering / split / metrics / figures as the\n#  CNN + PatchTST / CNN + GRU scripts.\n#\n#  ONLY the forecasting model architecture is changed:\n#\n#     x (B,T,F)\n#       -> Conv1d x2 (+BN, MaxPool /2)\n#       -> BiLSTM (stacked, bidirectional, batch_first)\n#       -> final fwd + bwd hidden state of last layer\n#       -> concat with \"known target-hour\" branch\n#       -> head -> delta\n#\n#  There is NO attention mechanism anywhere in this model.\n#\n#  Feature engineering is kept EXACTLY the same.\n#\n#  The validation-calibrated 95% conformal-style prediction interval around\n#  the ensemble point forecast is kept unchanged. Nothing about the training\n#  loop, feature engineering, data split, ensemble, interval, or existing\n#  metrics/figures has been changed.\n# =============================================================================\n\nimport os, sys, time, math, json, random, copy, warnings\nwarnings.filterwarnings(\"ignore\")\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom scipy import stats\n\nimport torch\nimport torch.nn as nn\nfrom sklearn.preprocessing import StandardScaler\n\n\n# =============================================================================\n# 0. CONFIG\n# =============================================================================\n\nSEED        = 43\nSEQ_LEN     = 168\nHORIZON     = int(os.environ.get(\"HORIZON\", 1))    # 1 = next hour, 24 = day-ahead\n\nVAL_DAYS    = 30\nTEST_DAYS   = 30\n\nN_MODELS    = 3\nMAX_EPOCHS  = 100\nPATIENCE    = 12\n\nBATCH_SIZE  = 256\nLR          = 1e-3\nWEIGHT_DECAY = 1e-5\n\n\n# -----------------------------------------------------------------------------\n# BiLSTM hyper-parameters\n# -----------------------------------------------------------------------------\n\nLSTM_HIDDEN  = 128    # per direction (BiLSTM output = 2 x this)\nLSTM_LAYERS  = 2\nLSTM_DROPOUT = 0.1     # dropout between stacked LSTM layers (ignored if 1 layer)\n\n\n# -----------------------------------------------------------------------------\n# Same feature configuration\n# -----------------------------------------------------------------------------\n\nUSE_RAW_STATION_WEATHER = True\nUSE_TARGET_WEATHER      = False\n\n\nSMOKE_TEST = os.environ.get(\"SMOKE_TEST\", \"0\") == \"1\"\n\nif SMOKE_TEST:\n    N_MODELS, MAX_EPOCHS, PATIENCE = 1, 2, 2\n\n\nMODEL_NAME = \"CNN-BiLSTM\"\nMAIN       = f\"{MODEL_NAME} (ensemble)\"\n\n\nassert 1 <= HORIZON <= 168\nassert LSTM_HIDDEN > 0\nassert LSTM_LAYERS >= 1\n\n\ndef set_seed(s):\n    random.seed(s)\n    np.random.seed(s)\n    torch.manual_seed(s)\n\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(s)\n\n\nset_seed(SEED)\n\ntorch.backends.cudnn.deterministic = True\ntorch.backends.cudnn.benchmark = False\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\nprint(\n    \"Device:\", device,\n    \"| HORIZON:\", HORIZON,\n    \"| SEQ_LEN:\", SEQ_LEN\n)\n\n\nOUT_DIR = (\n    \"/kaggle/working/results_cnn_bilstm\"\n    if os.path.isdir(\"/kaggle/working\")\n    else \"results_cnn_bilstm\"\n)\n\nif SMOKE_TEST:\n    OUT_DIR = \"results_cnn_bilstm_smoke\"\n\nos.makedirs(OUT_DIR, exist_ok=True)\n\n\n# =============================================================================\n# 1. LOAD + VALIDATE\n# =============================================================================\n\n\nimport os\nimport glob\nimport pandas as pd\n\n\n# Find CSV\n\ncsv_files = glob.glob(\n    \"/kaggle/input/**/*.csv\",\n    recursive=True\n)\n\nprint(\"CSV files found:\")\nfor f in csv_files:\n    print(f)\n\n\n# Select PGCB dataset\nPATH = [\n    f for f in csv_files \n    if \"PGCB\" in f\n][0]\n\n\nprint(\"\\nSelected file:\")\nprint(PATH)\n\n\n# Load dataset\n\ndata = pd.read_csv(PATH)\n\n\nprint(\"\\nDataset shape:\")\nprint(data.shape)\n\n\ndisplay(data.head())\n\n\n# Create datetime\n\ndata[\"datetime\"] = pd.to_datetime(\n    data[\"Date\"].astype(str) + \" \" +\n    data[\"Time\"].astype(str)\n)\n\n\n# Sort\n\ndata = data.sort_values(\n    \"datetime\"\n).reset_index(drop=True)\n\n\n\n# Validation\n\nassert not data[\"datetime\"].duplicated().any(), \\\n    \"Duplicate timestamps found\"\n\n\nassert data[\"Sequence_ID\"].is_monotonic_increasing, \\\n    \"Sequence_ID not chronological\"\n\n\n\nfor sid, g in data.groupby(\"Sequence_ID\"):\n\n    assert (\n        g[\"datetime\"].diff().dropna()\n        == pd.Timedelta(\"1h\")\n    ).all(), f\"Gap inside Sequence {sid}\"\n\n\nprint(\n    f\"Loaded {len(data):,} rows\"\n)\n\n\nif SMOKE_TEST:\n    data = data.tail(4200).reset_index(drop=True)\n\n\n\n# =============================================================================\n# 2. FEATURE ENGINEERING\n# =============================================================================\n# EXACTLY THE SAME FEATURE ENGINEERING AS YOUR ORIGINAL MODEL\n# =============================================================================\n\nSID = data[\"Sequence_ID\"]\n\ndt = data[\"datetime\"].dt\n\n\n# -----------------------------------------------------------------------------\n# 2.1 calendar\n# -----------------------------------------------------------------------------\n\ndata[\"Hour\"] = dt.hour\ndata[\"DoW\"]  = dt.dayofweek\n\n\nfor name, val, period in [\n    (\"Hour\", dt.hour, 24),\n    (\"DoW\", dt.dayofweek, 7),\n    (\"Month\", dt.month, 12),\n    (\"DoY\", dt.dayofyear, 365.25)\n]:\n\n    data[f\"{name}_sin\"] = np.sin(\n        2 * np.pi * val / period\n    )\n\n    data[f\"{name}_cos\"] = np.cos(\n        2 * np.pi * val / period\n    )\n\n\ndata[\"IsMorningPeak\"] = (\n    data[\"Hour\"].between(7, 10)\n).astype(float)\n\ndata[\"IsEveningPeak\"] = (\n    data[\"Hour\"].between(18, 21)\n).astype(float)\n\ndata[\"IsNight\"] = (\n    data[\"Hour\"].between(0, 5)\n).astype(float)\n\n\n# -----------------------------------------------------------------------------\n# 2.2 holidays\n# -----------------------------------------------------------------------------\n\ncat = data[\"Holiday_Category\"].astype(int)\n\ndata[\"IsWeekend\"] = (\n    cat == 1\n).astype(float)\n\ndata[\"IsPublicHoliday\"] = (\n    cat == 2\n).astype(float)\n\ndata[\"Hol_Since_Decay\"] = np.exp(\n    -data[\"Days_Since_Holiday\"] / 3.0\n)\n\ndata[\"Hol_Until_Decay\"] = np.exp(\n    -data[\"Days_Until_Holiday\"] / 3.0\n)\n\n\n# -----------------------------------------------------------------------------\n# 2.3 Ramadan\n# -----------------------------------------------------------------------------\n\n_EPOCH = 1948439.5\n\n\ndef _greg_to_jd(y, m, d):\n\n    a = (14 - m) // 12\n    yy = y + 4800 - a\n    mm = m + 12 * a - 3\n\n    return (\n        d\n        + (153 * mm + 2) // 5\n        + 365 * yy\n        + yy // 4\n        - yy // 100\n        + yy // 400\n        - 32045\n        - 0.5\n    )\n\n\ndef _isl_to_jd(y, m, d):\n\n    return (\n        d\n        + math.ceil(29.5 * (m - 1))\n        + (y - 1) * 354\n        + math.floor((3 + 11 * y) / 30)\n        + _EPOCH\n        - 1\n    )\n\n\ndef _islamic_month_day(ts):\n\n    jd = _greg_to_jd(\n        ts.year,\n        ts.month,\n        ts.day\n    )\n\n    y = math.floor(\n        (30 * (jd - _EPOCH) + 10646) / 10631\n    )\n\n    m = min(\n        12,\n        math.ceil(\n            (jd - (29 + _isl_to_jd(y, 1, 1))) / 29.5\n        ) + 1\n    )\n\n    return (\n        m,\n        int(jd - _isl_to_jd(y, m, 1) + 1)\n    )\n\n\n_days = (\n    data[\"datetime\"]\n    .dt.normalize()\n    .drop_duplicates()\n)\n\n_md = {\n    d: _islamic_month_day(d)\n    for d in _days\n}\n\n_dn = data[\"datetime\"].dt.normalize()\n\n\ndata[\"IsRamadan\"] = _dn.map(\n    lambda d: float(_md[d][0] == 9)\n)\n\ndata[\"Ramadan_Day\"] = _dn.map(\n    lambda d:\n        _md[d][1] / 30.0\n        if _md[d][0] == 9\n        else 0.0\n)\n\n\n# -----------------------------------------------------------------------------\n# 2.4 weather\n# -----------------------------------------------------------------------------\n\nSTATIONS = [\n    \"BAR\", \"CTG\", \"DHA\", \"KHU\",\n    \"MYM\", \"RAJ\", \"RAN\", \"SYL\"\n]\n\nWVARS = [\n    \"T2M\", \"RH2M\", \"WS10M\",\n    \"PS\", \"PRECTOTCORR\", \"PSC\", \"WSC\"\n]\n\n\nscols = lambda v: [\n    f\"{v}_{s}\"\n    for s in STATIONS\n]\n\n\ndata[\"T2M_mean\"] = data[\n    scols(\"T2M\")\n].mean(axis=1)\n\ndata[\"T2M_max\"] = data[\n    scols(\"T2M\")\n].max(axis=1)\n\ndata[\"T2M_min\"] = data[\n    scols(\"T2M\")\n].min(axis=1)\n\ndata[\"T2M_range\"] = (\n    data[\"T2M_max\"]\n    - data[\"T2M_min\"]\n)\n\ndata[\"RH2M_mean\"] = data[\n    scols(\"RH2M\")\n].mean(axis=1)\n\ndata[\"WS10M_mean\"] = data[\n    scols(\"WS10M\")\n].mean(axis=1)\n\ndata[\"PS_mean\"] = data[\n    scols(\"PS\")\n].mean(axis=1)\n\ndata[\"PRECTOTCORR_mean\"] = data[\n    scols(\"PRECTOTCORR\")\n].mean(axis=1)\n\ndata[\"CDH\"] = np.maximum(\n    data[\"T2M_mean\"] - 24.0,\n    0.0\n)\n\ndata[\"DewPoint\"] = (\n    data[\"T2M_mean\"]\n    - (100 - data[\"RH2M_mean\"]) / 5.0\n)\n\n\n_gT = data.groupby(\n    \"Sequence_ID\",\n    sort=False\n)[\"T2M_mean\"]\n\n\nfor w in (3, 6, 24):\n\n    data[f\"T2M_roll{w}\"] = _gT.transform(\n        lambda s, w=w:\n        s.rolling(w, min_periods=1).mean()\n    )\n\n\ndata[\"CDH_evening\"] = (\n    data[\"CDH\"]\n    * data[\"IsEveningPeak\"]\n)\n\ndata[\"CDH_morning\"] = (\n    data[\"CDH\"]\n    * data[\"IsMorningPeak\"]\n)\n\n\n# -----------------------------------------------------------------------------\n# 2.5 demand-derived features\n# -----------------------------------------------------------------------------\n\nBASE_LAGS = [\n    1, 2, 3,\n    24, 48, 72,\n    168, 336, 504, 672\n]\n\nROLL_WINDOWS = [\n    24, 72, 168\n]\n\nEWM_HALFLIVES = [\n    6, 24, 72, 168\n]\n\n\ndef demand_features(df, H):\n\n    sid = df[\"Sequence_ID\"]\n\n    g = df.groupby(\n        \"Sequence_ID\",\n        sort=False\n    )[\"Demand\"]\n\n    lev, oth = {}, {}\n\n\n    for k in sorted(\n        set([H] + [k for k in BASE_LAGS if k > H])\n    ):\n\n        lev[f\"lag{k}\"] = np.log(\n            g.shift(k)\n        )\n\n\n    base = g.shift(H)\n\n    lbase = np.log(base)\n\n    gb = base.groupby(\n        sid,\n        sort=False\n    )\n\n    gl = lbase.groupby(\n        sid,\n        sort=False\n    )\n\n\n    for w in ROLL_WINDOWS:\n\n        lev[f\"rmean{w}\"] = np.log(\n            gb.transform(\n                lambda s, w=w:\n                s.rolling(w).mean()\n            )\n        )\n\n        oth[f\"lstd{w}\"] = gl.transform(\n            lambda s, w=w:\n            s.rolling(w).std()\n        )\n\n\n    for hl in EWM_HALFLIVES:\n\n        lev[f\"ewm{hl}\"] = np.log(\n            gb.transform(\n                lambda s, hl=hl:\n                s.ewm(\n                    halflife=hl,\n                    adjust=False\n                ).mean()\n            )\n        )\n\n\n    k0 = math.ceil(H / 24)\n\n\n    lev[\"sameHour7d\"] = np.log(\n        pd.concat(\n            [\n                g.shift(24 * (k0 + j))\n                for j in range(7)\n            ],\n            axis=1\n        ).mean(\n            axis=1,\n            skipna=False\n        )\n    )\n\n\n    lev[\"sameHourDow4w\"] = np.log(\n        pd.concat(\n            [\n                g.shift(168 * m)\n                for m in range(1, 5)\n            ],\n            axis=1\n        ).mean(\n            axis=1,\n            skipna=False\n        )\n    )\n\n\n    for d in (1, 24, 72):\n\n        oth[f\"diff{d}\"] = (\n            lbase\n            - gl.shift(d)\n        )\n\n\n    return (\n        pd.DataFrame(lev),\n        pd.DataFrame(oth)\n    )\n\n\nlev_w, oth_w = demand_features(\n    data,\n    1\n)\n\nlev_w = lev_w.add_prefix(\"w_\")\noth_w = oth_w.add_prefix(\"w_\")\n\n\nLEV = pd.concat(\n    [\n        np.log(data[\"Demand\"]).rename(\"logD\"),\n        lev_w\n    ],\n    axis=1\n)\n\n\nwin_lev_names = list(\n    LEV.columns\n)\n\n\nif HORIZON == 1:\n\n    known_lev_names = list(\n        lev_w.columns\n    )\n\n    known_dem_oth = list(\n        oth_w.columns\n    )\n\n    OTH_dem = oth_w\n\n\nelse:\n\n    lev_t, oth_t = demand_features(\n        data,\n        HORIZON\n    )\n\n    lev_t = lev_t.add_prefix(\"t_\")\n    oth_t = oth_t.add_prefix(\"t_\")\n\n\n    LEV = pd.concat(\n        [\n            LEV,\n            lev_t\n        ],\n        axis=1\n    )\n\n\n    known_lev_names = list(\n        lev_t.columns\n    )\n\n    known_dem_oth = list(\n        oth_t.columns\n    )\n\n    OTH_dem = pd.concat(\n        [\n            oth_w,\n            oth_t\n        ],\n        axis=1\n    )\n\n\n# -----------------------------------------------------------------------------\n# 2.6 assemble other matrix\n# -----------------------------------------------------------------------------\n\ncal_cols = [\n    \"Hour_sin\",\n    \"Hour_cos\",\n    \"DoW_sin\",\n    \"DoW_cos\",\n    \"Month_sin\",\n    \"Month_cos\",\n    \"DoY_sin\",\n    \"DoY_cos\"\n]\n\n\nflag_cols = [\n    \"IsWeekend\",\n    \"IsPublicHoliday\",\n    \"IsRamadan\",\n    \"Ramadan_Day\",\n    \"IsMorningPeak\",\n    \"IsEveningPeak\",\n    \"IsNight\",\n    \"Days_Since_Holiday\",\n    \"Days_Until_Holiday\",\n    \"Hol_Since_Decay\",\n    \"Hol_Until_Decay\"\n]\n\n\nwagg_cols = [\n    \"T2M_mean\",\n    \"T2M_max\",\n    \"T2M_min\",\n    \"T2M_range\",\n    \"RH2M_mean\",\n    \"WS10M_mean\",\n    \"PS_mean\",\n    \"PRECTOTCORR_mean\",\n    \"CDH\",\n    \"DewPoint\",\n    \"T2M_roll3\",\n    \"T2M_roll6\",\n    \"T2M_roll24\",\n    \"CDH_evening\",\n    \"CDH_morning\"\n]\n\n\nraw_cols = (\n    [\n        f\"{v}_{s}\"\n        for s in STATIONS\n        for v in WVARS\n    ]\n    if USE_RAW_STATION_WEATHER\n    else [\n        \"T2M_DHA\",\n        \"RH2M_DHA\"\n    ]\n)\n\n\nonehot = pd.concat(\n    [\n        pd.get_dummies(\n            data[\"Hour\"],\n            prefix=\"Hr\"\n        ).astype(float).reindex(\n            columns=[\n                f\"Hr_{h}\"\n                for h in range(24)\n            ],\n            fill_value=0.0\n        ),\n\n        pd.get_dummies(\n            data[\"DoW\"],\n            prefix=\"Dw\"\n        ).astype(float).reindex(\n            columns=[\n                f\"Dw_{d}\"\n                for d in range(7)\n            ],\n            fill_value=0.0\n        )\n    ],\n    axis=1\n)\n\n\nOTH = pd.concat(\n    [\n        data[\n            cal_cols\n            + flag_cols\n            + wagg_cols\n            + raw_cols\n        ],\n        onehot,\n        OTH_dem\n    ],\n    axis=1\n)\n\n\nOTH = OTH.loc[\n    :,\n    ~OTH.columns.duplicated()\n]\n\n\nwin_oth_names = (\n    cal_cols\n    + flag_cols\n    + wagg_cols\n    + raw_cols\n    + list(oth_w.columns)\n)\n\n\nknown_oth_names = (\n    cal_cols\n    + flag_cols\n    + list(onehot.columns)\n    + known_dem_oth\n    + (\n        wagg_cols\n        if USE_TARGET_WEATHER\n        else []\n    )\n)\n\n\n# -----------------------------------------------------------------------------\n# 2.7 drop warm-up rows\n# -----------------------------------------------------------------------------\n\nkeep = (\n    LEV.notna().all(axis=1)\n    & OTH.notna().all(axis=1)\n)\n\n\nprint(\n    f\"Dropping {(~keep).sum()} warm-up rows \"\n    f\"(lag-672 history) at the start of each sequence.\"\n)\n\n\ndata = (\n    data[keep]\n    .reset_index(drop=True)\n)\n\nLEV = (\n    LEV[keep]\n    .reset_index(drop=True)\n)\n\nOTH = (\n    OTH[keep]\n    .reset_index(drop=True)\n)\n\n\nfor sid, g in data.groupby(\"Sequence_ID\"):\n\n    assert (\n        g[\"datetime\"].diff().dropna()\n        == pd.Timedelta(\"1h\")\n    ).all()\n\n\nD_raw = data[\"Demand\"].to_numpy(\n    dtype=np.float64\n)\n\nN = len(data)\n\n\nprint(\n    f\"Usable rows: {N:,} | \"\n    f\"level feats: {len(win_lev_names)} | \"\n    f\"other feats: {len(win_oth_names)} | \"\n    f\"known-target feats: \"\n    f\"{len(known_lev_names) + len(known_oth_names)}\"\n)\n\n# =============================================================================\n# Correlation Heatmap\n# =============================================================================\n\nimport seaborn as sns\n\ncorr_features = [\n    \"Demand\",\n    \"T2M_mean\",\n    \"RH2M_mean\",\n    \"WS10M_mean\",\n    \"PS_mean\",\n    \"PRECTOTCORR_mean\",\n    \"CDH\",\n    \"DewPoint\",\n    \"Days_Since_Holiday\",\n    \"Days_Until_Holiday\",\n    \"IsWeekend\",\n    \"IsPublicHoliday\",\n    \"IsRamadan\"\n]\n\ncorr_matrix = data[corr_features].corr()\n\nplt.figure(figsize=(10, 8))\n\nsns.heatmap(\n    corr_matrix,\n    annot=True,\n    fmt=\".2f\",\n    cmap=\"RdBu_r\",\n    center=0,\n    linewidths=0.5,\n    square=True\n)\n\nplt.title(\n    \"Correlation Heatmap of PGCB Load Forecasting Variables\",\n    fontsize=14,\n    fontweight=\"bold\"\n)\n\nplt.xticks(rotation=45, ha=\"right\")\nplt.yticks(rotation=0)\n\nplt.tight_layout()\n\nplt.savefig(\n    f\"{OUT_DIR}/fig0_correlation_heatmap.png\",\n    dpi=300,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\n# =============================================================================\n# 3. SAMPLES + CHRONOLOGICAL SPLIT\n# =============================================================================\n\npos_in_seq = (\n    data.groupby(\"Sequence_ID\")\n    .cumcount()\n    .to_numpy()\n)\n\n\nMIN_POS = max(\n    SEQ_LEN + HORIZON - 1,\n    168\n)\n\n\nvalid_t = np.where(\n    pos_in_seq >= MIN_POS\n)[0]\n\n\nVAL_N = VAL_DAYS * 24\nTEST_N = TEST_DAYS * 24\n\n\ntest_t = valid_t[-TEST_N:]\n\nval_t = valid_t[\n    -(TEST_N + VAL_N):-TEST_N\n]\n\ntrain_t = valid_t[\n    :-(TEST_N + VAL_N)\n]\n\n\nassert (\n    test_t[-1] - val_t[0] + 1\n    == VAL_N + TEST_N\n), \"val/test must be contiguous in time\"\n\nassert train_t[-1] < val_t[0]\n\n\ndef span(t):\n\n    return (\n        f\"{data['datetime'][t[0]]:%Y-%m-%d %H:%M}\"\n        f\" -> \"\n        f\"{data['datetime'][t[-1]]:%Y-%m-%d %H:%M}\"\n    )\n\n\nprint(\n    f\"\\nTrain: {len(train_t):>6,}  {span(train_t)}\"\n    f\"\\nVal  : {len(val_t):>6,}  {span(val_t)}\"\n    f\"\\nTest : {len(test_t):>6,}  {span(test_t)}\"\n)\n\n\nsplit_table = pd.DataFrame(\n    {\n        \"split\": [\n            \"train\",\n            \"val\",\n            \"test\"\n        ],\n        \"n_samples\": [\n            len(train_t),\n            len(val_t),\n            len(test_t)\n        ],\n        \"start\": [\n            data[\"datetime\"][x[0]]\n            for x in (\n                train_t,\n                val_t,\n                test_t\n            )\n        ],\n        \"end\": [\n            data[\"datetime\"][x[-1]]\n            for x in (\n                train_t,\n                val_t,\n                test_t\n            )\n        ]\n    }\n)\n\n\nsplit_table.to_csv(\n    f\"{OUT_DIR}/data_splits.csv\",\n    index=False\n)\n\n\n# -----------------------------------------------------------------------------\n# scaling\n# -----------------------------------------------------------------------------\n\nfit_rows = np.arange(\n    train_t[-1] + 1\n)\n\n\nscaler = StandardScaler().fit(\n    OTH.iloc[fit_rows]\n    .to_numpy(dtype=np.float64)\n)\n\n\nOTH_s = np.clip(\n    scaler.transform(\n        OTH.to_numpy(dtype=np.float64)\n    ),\n    -10,\n    10\n).astype(np.float32)\n\n\nLEV_np = LEV.to_numpy(\n    dtype=np.float32\n)\n\n\niw = LEV.columns.get_loc(\n    \"w_lag168\"\n)\n\n\nLEV_SCALE = float(\n    np.std(\n        LEV_np[\n            fit_rows,\n            0\n        ]\n        -\n        LEV_np[\n            fit_rows,\n            iw\n        ]\n    )\n)\n\n\nY_SCALE = float(\n    np.std(\n        LEV_np[\n            train_t,\n            0\n        ]\n        -\n        LEV_np[\n            train_t - HORIZON,\n            0\n        ]\n    )\n)\n\n\nprint(\n    f\"LEV_SCALE={LEV_SCALE:.4f} \"\n    f\"Y_SCALE={Y_SCALE:.4f}\"\n)\n\n\nnp.savez(\n    f\"{OUT_DIR}/scaler_params.npz\",\n    mean=scaler.mean_,\n    scale=scaler.scale_,\n    cols=np.array(OTH.columns),\n    lev_scale=LEV_SCALE,\n    y_scale=Y_SCALE\n)\n\n\nidx = lambda names, cols: [\n    list(cols).index(n)\n    for n in names\n]\n\n\nwin_lev_idx = idx(\n    win_lev_names,\n    LEV.columns\n)\n\nknown_lev_idx = idx(\n    known_lev_names,\n    LEV.columns\n)\n\nwin_oth_idx = idx(\n    win_oth_names,\n    OTH.columns\n)\n\nknown_oth_idx = idx(\n    known_oth_names,\n    OTH.columns\n)\n\n\nto_t = lambda a: torch.tensor(\n    a,\n    dtype=torch.float32,\n    device=device\n)\n\n\nLEV_ALL = to_t(LEV_np)\n\nLEV_WIN = LEV_ALL[\n    :,\n    win_lev_idx\n]\n\nLEV_KNOWN = LEV_ALL[\n    :,\n    known_lev_idx\n]\n\nOTH_WIN = to_t(\n    OTH_s[\n        :,\n        win_oth_idx\n    ]\n)\n\nOTH_KNOWN = to_t(\n    OTH_s[\n        :,\n        known_oth_idx\n    ]\n)\n\n\nAR = torch.arange(\n    SEQ_LEN,\n    device=device\n)\n\n\nN_SEQ_FEAT = (\n    len(win_lev_idx)\n    + len(win_oth_idx)\n)\n\nN_KNOWN = (\n    len(known_lev_idx)\n    + len(known_oth_idx)\n)\n\n\nprint(\n    f\"\\nN_SEQ_FEAT = {N_SEQ_FEAT}\"\n)\n\nprint(\n    f\"N_KNOWN    = {N_KNOWN}\"\n)\n\n\n# =============================================================================\n# BATCH CREATION\n# =============================================================================\n\ndef get_batch(t):\n\n    \"\"\"\n    t:\n        LongTensor (B,)\n\n    Returns:\n        x         (B,T,F)\n        known     (B,K)\n        y_scaled  (B,)\n    \"\"\"\n\n    ref_row = t - HORIZON\n\n\n    rows = (\n        (\n            ref_row\n            - SEQ_LEN\n            + 1\n        ).unsqueeze(1)\n        +\n        AR.unsqueeze(0)\n    )\n\n\n    ref = LEV_ALL[\n        ref_row,\n        0\n    ]\n\n\n    xl = (\n        LEV_WIN[rows]\n        -\n        ref[:, None, None]\n    ) / LEV_SCALE\n\n\n    x = torch.cat(\n        [\n            xl,\n            OTH_WIN[rows]\n        ],\n        dim=-1\n    )\n\n\n    k = torch.cat(\n        [\n            (\n                LEV_KNOWN[t]\n                -\n                ref[:, None]\n            ) / LEV_SCALE,\n\n            OTH_KNOWN[t]\n        ],\n        dim=-1\n    )\n\n\n    y = (\n        LEV_ALL[t, 0]\n        - ref\n    ) / Y_SCALE\n\n\n    return x, k, y\n\n\ntt = lambda a: torch.as_tensor(\n    a,\n    dtype=torch.long,\n    device=device\n)\n\n\ntrain_T = tt(train_t)\nval_T   = tt(val_t)\ntest_T  = tt(test_t)\n\n\ndef to_mw(delta_scaled, t_idx):\n\n    return (\n        D_raw[\n            np.asarray(t_idx) - HORIZON\n        ]\n        *\n        np.exp(\n            np.asarray(delta_scaled)\n            *\n            Y_SCALE\n        )\n    )\n\n\n# =============================================================================\n# 4. MODEL\n# =============================================================================\n# CNN -> BiLSTM -> final fwd/bwd hidden (+ known target-hour branch)\n# =============================================================================\n\n\nclass CNN_BiLSTM(nn.Module):\n\n    def __init__(\n        self,\n        n_seq,\n        n_known,\n        seq_len=SEQ_LEN,\n        lstm_hidden=LSTM_HIDDEN,\n        lstm_layers=LSTM_LAYERS,\n        lstm_dropout=LSTM_DROPOUT\n    ):\n\n        super().__init__()\n\n\n        # ---------------------------------------------------------------------\n        # CNN front-end (unchanged)\n        # ---------------------------------------------------------------------\n\n        self.conv1 = nn.Conv1d(n_seq, 128, kernel_size=5, padding=2)\n        self.bn1   = nn.BatchNorm1d(128)\n\n        self.conv2 = nn.Conv1d(128, 64, kernel_size=3, padding=1)\n        self.bn2   = nn.BatchNorm1d(64)\n\n        self.pool      = nn.MaxPool1d(2)\n        self.drop_conv = nn.Dropout(0.2)\n\n\n        # ---------------------------------------------------------------------\n        # CNN output length (number of BiLSTM time steps)\n        # ---------------------------------------------------------------------\n\n        self.n_steps = seq_len // 2\n\n        if self.n_steps <= 0:\n            raise ValueError(\n                f\"SEQ_LEN={seq_len} is too short for the CNN front-end\"\n            )\n\n        self.lstm_hidden = lstm_hidden\n        self.lstm_layers = lstm_layers\n\n        print(\"\\nBiLSTM configuration:\")\n        print(f\"  CNN output length (LSTM steps) : {self.n_steps}\")\n        print(f\"  LSTM hidden size (per direction): {lstm_hidden}\")\n        print(f\"  LSTM layers                    : {lstm_layers}\")\n        print(f\"  Bidirectional output size      : {2 * lstm_hidden}\")\n\n\n        # ---------------------------------------------------------------------\n        # BiLSTM encoder\n        #\n        # input  : (B, T/2, 64)\n        # output : (B, T/2, 2*lstm_hidden)\n        # ---------------------------------------------------------------------\n\n        self.lstm = nn.LSTM(\n            input_size=64,\n            hidden_size=lstm_hidden,\n            num_layers=lstm_layers,\n            batch_first=True,\n            bidirectional=True,\n            dropout=lstm_dropout if lstm_layers > 1 else 0.0\n        )\n\n\n        # ---------------------------------------------------------------------\n        # Known target-hour branch (unchanged)\n        # ---------------------------------------------------------------------\n\n        self.known = nn.Sequential(\n            nn.Linear(n_known, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU()\n        )\n\n\n        # ---------------------------------------------------------------------\n        # Forecast head\n        #\n        # summary = 2 * lstm_hidden   (forward final + backward final)\n        # known   = 64\n        # ---------------------------------------------------------------------\n\n        self.head = nn.Sequential(\n            nn.Linear(2 * lstm_hidden + 64, 128),\n            nn.ReLU(),\n            nn.Dropout(0.3),\n            nn.Linear(128, 1)\n        )\n\n\n    def forward(self, x, k):\n\n        # x = (B,T,F)\n        z = x.permute(0, 2, 1)\n\n\n        # CNN\n        z = self.conv1(z)\n        z = self.bn1(z)\n        z = torch.relu(z)\n        z = self.pool(z)\n\n        z = self.conv2(z)\n        z = self.bn2(z)\n        z = torch.relu(z)\n        z = self.drop_conv(z)\n\n\n        # (B,64,T/2) -> (B,T/2,64) for the LSTM\n        z = z.permute(0, 2, 1)\n\n\n        # BiLSTM\n        # h_n : (num_layers * 2, B, lstm_hidden)\n        _, (h_n, _) = self.lstm(z)\n\n\n        # ---------------------------------------------------------------------\n        # Sequence summary (NO attention):\n        # final hidden state of the LAST layer, both directions.\n        #   h_n[-2] = forward  direction (has read steps 0 .. T/2-1)\n        #   h_n[-1] = backward direction (has read steps T/2-1 .. 0)\n        # NOTE: z[:, -1] would be wrong here -- at the last time step the\n        # backward direction has only seen ONE input, so we use h_n instead.\n        # ---------------------------------------------------------------------\n\n        last = torch.cat([h_n[-2], h_n[-1]], dim=1)      # (B, 2*lstm_hidden)\n\n\n        # Known target-hour branch\n        known = self.known(k)\n\n\n        # Final forecasting head\n        out = self.head(\n            torch.cat([last, known], dim=1)\n        ).squeeze(-1)\n\n        return out\n\n\n# =============================================================================\n# 5. TRAINING\n# =============================================================================\n\ndef predict(\n    model,\n    t_tensor,\n    bs=1024\n):\n\n    model.eval()\n\n    out = []\n\n\n    with torch.no_grad():\n\n        for i in range(\n            0,\n            len(t_tensor),\n            bs\n        ):\n\n            x, k, _ = get_batch(\n                t_tensor[\n                    i:i + bs\n                ]\n            )\n\n            out.append(\n                model(\n                    x,\n                    k\n                )\n                .cpu()\n                .numpy()\n            )\n\n\n    return np.concatenate(\n        out\n    )\n\n\ndef mape_fn(y, p):\n\n    return float(\n        np.mean(\n            np.abs(y - p) / y\n        )\n        * 100\n    )\n\n\n# =============================================================================\n# TRAIN ONE MODEL\n# =============================================================================\n\ndef train_one_model(seed):\n\n    set_seed(seed)\n\n\n    model = CNN_BiLSTM(\n        N_SEQ_FEAT,\n        N_KNOWN\n    ).to(device)\n\n\n    n_params = sum(\n        p.numel()\n        for p in model.parameters()\n        if p.requires_grad\n    )\n\n\n    print(\n        f\"[seed {seed}] \"\n        f\"trainable parameters: {n_params:,}\"\n    )\n\n\n    opt = torch.optim.AdamW(\n        model.parameters(),\n        lr=LR,\n        weight_decay=WEIGHT_DECAY\n    )\n\n\n    sched = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        opt,\n        mode=\"min\",\n        factor=0.5,\n        patience=5\n    )\n\n\n    crit = nn.SmoothL1Loss(\n        beta=0.5\n    )\n\n\n    hist = {\n        \"train_loss\": [],\n        \"val_loss\": [],\n        \"val_mape\": [],\n        \"lr\": []\n    }\n\n\n    best = float(\"inf\")\n\n    best_state = None\n\n    best_ep = 0\n\n    bad = 0\n\n\n    y_val_true = D_raw[\n        val_t\n    ]\n\n\n    t_start = time.time()\n\n\n    # -------------------------------------------------------------------------\n    # epochs\n    # -------------------------------------------------------------------------\n\n    for ep in range(\n        1,\n        MAX_EPOCHS + 1\n    ):\n\n        model.train()\n\n        ep0 = time.time()\n\n\n        perm = train_T[\n            torch.randperm(\n                len(train_T),\n                device=device\n            )\n        ]\n\n\n        tot = 0.0\n        nb = 0\n\n\n        for i in range(\n            0,\n            len(perm),\n            BATCH_SIZE\n        ):\n\n            bt = perm[\n                i:i + BATCH_SIZE\n            ]\n\n\n            if len(bt) < 8:\n                continue\n\n\n            x, k, y = get_batch(\n                bt\n            )\n\n\n            opt.zero_grad()\n\n\n            pred = model(\n                x,\n                k\n            )\n\n\n            loss = crit(\n                pred,\n                y\n            )\n\n\n            loss.backward()\n\n\n            nn.utils.clip_grad_norm_(\n                model.parameters(),\n                5.0\n            )\n\n\n            opt.step()\n\n\n            tot += loss.item()\n\n            nb += 1\n\n\n        tr_loss = (\n            tot\n            /\n            max(nb, 1)\n        )\n\n\n        # ---------------------------------------------------------------------\n        # validation\n        # ---------------------------------------------------------------------\n\n        vp = predict(\n            model,\n            val_T\n        )\n\n\n        with torch.no_grad():\n\n            yv = torch.cat(\n                [\n                    get_batch(\n                        val_T[\n                            i:i + 1024\n                        ]\n                    )[2]\n\n                    for i in range(\n                        0,\n                        len(val_T),\n                        1024\n                    )\n                ]\n            )\n\n\n            va_loss = crit(\n                torch.as_tensor(\n                    vp,\n                    device=device\n                ),\n                yv\n            ).item()\n\n\n        va_mape = mape_fn(\n            y_val_true,\n            to_mw(\n                vp,\n                val_t\n            )\n        )\n\n\n        sched.step(\n            va_loss\n        )\n\n\n        hist[\n            \"train_loss\"\n        ].append(\n            tr_loss\n        )\n\n        hist[\n            \"val_loss\"\n        ].append(\n            va_loss\n        )\n\n        hist[\n            \"val_mape\"\n        ].append(\n            va_mape\n        )\n\n        hist[\n            \"lr\"\n        ].append(\n            opt.param_groups[0][\"lr\"]\n        )\n\n\n        print(\n            f\"[seed {seed}] \"\n            f\"ep {ep:02d} | \"\n            f\"train {tr_loss:.4f} | \"\n            f\"val {va_loss:.4f} | \"\n            f\"val MAPE {va_mape:.3f}% | \"\n            f\"lr {opt.param_groups[0]['lr']:.1e} | \"\n            f\"{time.time() - ep0:.1f}s\"\n        )\n\n\n        # ---------------------------------------------------------------------\n        # early stopping\n        # ---------------------------------------------------------------------\n\n        if va_loss < best:\n\n            best = va_loss\n\n            best_ep = ep\n\n            bad = 0\n\n            best_state = copy.deepcopy(\n                model.state_dict()\n            )\n\n\n        else:\n\n            bad += 1\n\n\n            if bad >= PATIENCE:\n\n                print(\n                    f\"[seed {seed}] \"\n                    f\"early stop \"\n                    f\"(best epoch {best_ep})\"\n                )\n\n                break\n\n\n    # -------------------------------------------------------------------------\n    # training time\n    # -------------------------------------------------------------------------\n\n    train_time = (\n        time.time()\n        - t_start\n    )\n\n\n    model.load_state_dict(\n        best_state\n    )\n\n\n    torch.save(\n        best_state,\n        f\"{OUT_DIR}/\"\n        f\"cnn_bilstm_seed{seed}.pt\"\n    )\n\n\n    # -------------------------------------------------------------------------\n    # test inference\n    # -------------------------------------------------------------------------\n\n    t0 = time.time()\n\n    tp = predict(\n        model,\n        test_T\n    )\n\n    infer_ms = (\n        (time.time() - t0)\n        / len(test_T)\n        * 1e3\n    )\n\n\n    return dict(\n        seed=seed,\n        val_pred=predict(\n            model,\n            val_T\n        ),\n        test_pred=tp,\n        hist=hist,\n        best_epoch=best_ep,\n        n_params=n_params,\n        train_time_s=train_time,\n        infer_ms_per_sample=infer_ms,\n        model=model\n    )\n\n\n# =============================================================================\n# TRAIN ENSEMBLE\n# =============================================================================\n\nresults = [\n    train_one_model(\n        SEED + i\n    )\n    for i in range(N_MODELS)\n]\n\n\n# =============================================================================\n# 6. PREDICTIONS\n# =============================================================================\n\ny_true = D_raw[\n    test_t\n]\n\n\ndts_test = (\n    data[\"datetime\"]\n    .iloc[test_t]\n    .reset_index(drop=True)\n)\n\n\npreds = {}\n\n\npreds[MAIN] = to_mw(\n    np.mean(\n        [\n            r[\"test_pred\"]\n            for r in results\n        ],\n        axis=0\n    ),\n    test_t\n)\n\n\n# =============================================================================\n# 6.1 95% PREDICTION INTERVAL\n# =============================================================================\n# Validation-calibrated 95% prediction interval (conformal-style).\n#\n# NOTE ON TERMINOLOGY: this is described as \"conformal-style\" rather than a\n# strict conformal prediction interval, because hourly load residuals are\n# temporally dependent (autocorrelated, seasonal in magnitude across\n# hour-of-day / load level), which violates the exchangeability assumption\n# behind a strict finite-sample conformal guarantee. It is an empirical,\n# validation-calibrated interval using the conformal calibration-quantile\n# formula.\n#\n# The validation predictions are used only to estimate the prediction error.\n# The resulting uncertainty radius is then applied to the test forecast.\n#\n# This does NOT change:\n#   - model architecture\n#   - training\n#   - feature engineering\n#   - data split\n#   - existing predictions\n#   - existing metrics\n#\n# It only adds:\n#   - 95% lower prediction bound\n#   - 95% upper prediction bound\n#   - interval width\n#   - coverage statistics\n# =============================================================================\n\nPI_CONFIDENCE = 0.95\n\n\n# -----------------------------------------------------------------------------\n# Validation ensemble prediction\n# -----------------------------------------------------------------------------\n\nval_ensemble_scaled = np.mean(\n    [\n        r[\"val_pred\"]\n        for r in results\n    ],\n    axis=0\n)\n\n\n# Convert validation prediction from scaled delta\n# back to MW\n\nval_ensemble_mw = to_mw(\n    val_ensemble_scaled,\n    val_t\n)\n\n\ny_val_true_mw = D_raw[\n    val_t\n]\n\n\n# -----------------------------------------------------------------------------\n# Absolute validation residuals\n# -----------------------------------------------------------------------------\n\nval_residuals = (\n    y_val_true_mw\n    -\n    val_ensemble_mw\n)\n\n\nval_abs_errors = np.abs(\n    val_residuals\n)\n\n\n# -----------------------------------------------------------------------------\n# Conformal calibration quantile\n# -----------------------------------------------------------------------------\n\nn_val = len(\n    val_abs_errors\n)\n\n\nq_level = (\n    np.ceil(\n        (n_val + 1)\n        * PI_CONFIDENCE\n    )\n    / n_val\n)\n\n\nq_level = min(\n    q_level,\n    1.0\n)\n\n\nPI_RADIUS = float(\n    np.quantile(\n        val_abs_errors,\n        q_level,\n        method=\"higher\"\n    )\n)\n\n\n# -----------------------------------------------------------------------------\n# Test prediction interval\n# -----------------------------------------------------------------------------\n\ntest_point_forecast = preds[\n    MAIN\n]\n\n\ntest_lower_pi = (\n    test_point_forecast\n    -\n    PI_RADIUS\n)\n\n\ntest_upper_pi = (\n    test_point_forecast\n    +\n    PI_RADIUS\n)\n\n\n# Demand cannot be negative\n\ntest_lower_pi = np.maximum(\n    test_lower_pi,\n    0.0\n)\n\n\n# -----------------------------------------------------------------------------\n# Prediction interval statistics\n# -----------------------------------------------------------------------------\n\npi_width = (\n    test_upper_pi\n    -\n    test_lower_pi\n)\n\n\ninside_pi = (\n    (y_true >= test_lower_pi)\n    &\n    (y_true <= test_upper_pi)\n)\n\n\npi_coverage = (\n    np.mean(inside_pi)\n    * 100\n)\n\n\npi_stats = pd.DataFrame(\n    [\n        {\n            \"Confidence level (%)\":\n                PI_CONFIDENCE * 100,\n\n            \"Calibration samples\":\n                n_val,\n\n            \"Calibration quantile\":\n                q_level,\n\n            \"PI radius (MW)\":\n                PI_RADIUS,\n\n            \"Mean PI width (MW)\":\n                np.mean(pi_width),\n\n            \"Median PI width (MW)\":\n                np.median(pi_width),\n\n            \"Minimum PI width (MW)\":\n                np.min(pi_width),\n\n            \"Maximum PI width (MW)\":\n                np.max(pi_width),\n\n            \"Test coverage (%)\":\n                pi_coverage,\n\n            \"Outside interval (%)\":\n                100 - pi_coverage\n        }\n    ]\n)\n\n\npi_stats.to_csv(\n    f\"{OUT_DIR}/prediction_interval_statistics.csv\",\n    index=False\n)\n\n\n# -----------------------------------------------------------------------------\n# Save prediction interval results\n# -----------------------------------------------------------------------------\n\npd.DataFrame(\n    {\n        \"datetime\":\n            dts_test,\n\n        \"actual_MW\":\n            y_true,\n\n        \"forecast_MW\":\n            test_point_forecast,\n\n        \"lower_95_PI_MW\":\n            test_lower_pi,\n\n        \"upper_95_PI_MW\":\n            test_upper_pi,\n\n        \"PI_width_MW\":\n            pi_width,\n\n        \"inside_95_PI\":\n            inside_pi\n    }\n).to_csv(\n    f\"{OUT_DIR}/prediction_intervals_95.csv\",\n    index=False\n)\n\n\nprint(\n    \"\\n--- 95% Prediction Interval ---\"\n)\n\nprint(\n    f\"Confidence level : \"\n    f\"{PI_CONFIDENCE * 100:.1f}%\"\n)\n\nprint(\n    f\"Calibration radius: \"\n    f\"{PI_RADIUS:.2f} MW\"\n)\n\nprint(\n    f\"Mean PI width     : \"\n    f\"{np.mean(pi_width):.2f} MW\"\n)\n\nprint(\n    f\"Median PI width   : \"\n    f\"{np.median(pi_width):.2f} MW\"\n)\n\nprint(\n    f\"Test coverage     : \"\n    f\"{pi_coverage:.2f}%\"\n)\n\nprint(\n    f\"Outside interval  : \"\n    f\"{100 - pi_coverage:.2f}%\"\n)\n\n\npreds[\n    f\"Persistence (t-{HORIZON}h)\"\n] = D_raw[\n    test_t - HORIZON\n]\n\n\nif HORIZON < 24:\n\n    preds[\n        \"Seasonal naive (t-24h)\"\n    ] = D_raw[\n        test_t - 24\n    ]\n\n\npreds[\n    \"Seasonal naive (t-168h)\"\n] = D_raw[\n    test_t - 168\n]\n\n\npersist_pred = preds[\n    f\"Persistence (t-{HORIZON}h)\"\n]\n\n\nm_seas = max(\n    24,\n    HORIZON\n)\n\n\nmase_scale = float(\n    np.mean(\n        np.abs(\n            D_raw[train_t]\n            -\n            D_raw[\n                train_t - m_seas\n            ]\n        )\n    )\n)\n\n\n# =============================================================================\n# 7. EVALUATION METRICS\n# =============================================================================\n\ndef compute_metrics(\n    y,\n    p,\n    y_ref=None,\n    mase_scale=None\n):\n\n    e = y - p\n\n    ae = np.abs(e)\n\n    ape = ae / y * 100\n\n\n    mae = ae.mean()\n\n    rmse = np.sqrt(\n        np.mean(e ** 2)\n    )\n\n\n    ybar = y.mean()\n\n\n    ss_res = np.sum(\n        e ** 2\n    )\n\n    ss_tot = np.sum(\n        (y - ybar) ** 2\n    )\n\n\n    m = {\n\n        \"MAE (MW)\": mae,\n\n        \"RMSE (MW)\": rmse,\n\n        \"MAPE (%)\": ape.mean(),\n\n        \"sMAPE (%)\":\n            np.mean(\n                200 * ae\n                /\n                (\n                    np.abs(y)\n                    +\n                    np.abs(p)\n                )\n            ),\n\n        \"WAPE (%)\":\n            100 * ae.sum()\n            / y.sum(),\n\n        \"NRMSE (% of mean)\":\n            100 * rmse / ybar,\n\n        \"NRMSE (% of range)\":\n            100 * rmse\n            /\n            (y.max() - y.min()),\n\n        \"R2\":\n            1 - ss_res / ss_tot,\n\n        \"Pearson r\":\n            np.corrcoef(\n                y,\n                p\n            )[0, 1],\n\n        \"Willmott d\":\n            1\n            -\n            ss_res\n            /\n            np.sum(\n                (\n                    np.abs(\n                        p - ybar\n                    )\n                    +\n                    np.abs(\n                        y - ybar\n                    )\n                ) ** 2\n            ),\n\n        \"MBE (MW, +=over)\":\n            np.mean(\n                p - y\n            ),\n\n        \"MPE (%, +=over)\":\n            np.mean(\n                (p - y) / y\n            ) * 100,\n\n        \"MedAE (MW)\":\n            np.median(ae),\n\n        \"MedAPE (%)\":\n            np.median(ape),\n\n        \"P90 APE (%)\":\n            np.percentile(\n                ape,\n                90\n            ),\n\n        \"P95 APE (%)\":\n            np.percentile(\n                ape,\n                95\n            ),\n\n        \"Max AE (MW)\":\n            ae.max(),\n\n        \"Max APE (%)\":\n            ape.max(),\n\n        \"Hours APE<=2% (%)\":\n            100 * np.mean(\n                ape <= 2\n            ),\n\n        \"Hours APE<=5% (%)\":\n            100 * np.mean(\n                ape <= 5\n            )\n    }\n\n\n    if mase_scale is not None:\n\n        m[\"MASE\"] = (\n            mae / mase_scale\n        )\n\n\n    if y_ref is not None:\n\n        m[\n            \"Theil U2 (vs persistence)\"\n        ] = (\n            rmse\n            /\n            np.sqrt(\n                np.mean(\n                    (y - y_ref) ** 2\n                )\n            )\n        )\n\n\n        m[\n            \"Skill vs persistence, MAE (%)\"\n        ] = (\n            100\n            *\n            (\n                1\n                -\n                mae\n                /\n                np.mean(\n                    np.abs(\n                        y - y_ref\n                    )\n                )\n            )\n        )\n\n\n    return {\n        k: float(v)\n        for k, v in m.items()\n    }\n\n\n# =============================================================================\n# DAILY PEAK METRICS\n# =============================================================================\n\ndef daily_peak_metrics(\n    dts,\n    y,\n    p\n):\n\n    d = pd.DataFrame(\n        {\n            \"date\":\n                dts.dt.normalize(),\n\n            \"hour\":\n                dts.dt.hour,\n\n            \"y\":\n                y,\n\n            \"p\":\n                p\n        }\n    )\n\n\n    d = d.groupby(\n        \"date\"\n    ).filter(\n        lambda g:\n        len(g) == 24\n    )\n\n\n    rows = []\n\n\n    for _, g in d.groupby(\n        \"date\"\n    ):\n\n        rows.append(\n            (\n                g.y.max(),\n                g.p.max(),\n                g.hour.iloc[\n                    g.y.values.argmax()\n                ],\n                g.hour.iloc[\n                    g.p.values.argmax()\n                ]\n            )\n        )\n\n\n    a = np.array(\n        rows,\n        dtype=float\n    )\n\n\n    return {\n\n        \"Peak MAE (MW)\":\n            np.mean(\n                np.abs(\n                    a[:, 0]\n                    -\n                    a[:, 1]\n                )\n            ),\n\n        \"Peak MAPE (%)\":\n            np.mean(\n                np.abs(\n                    a[:, 0]\n                    -\n                    a[:, 1]\n                )\n                /\n                a[:, 0]\n            )\n            * 100,\n\n        \"Peak-hour exact hit (%)\":\n            100\n            *\n            np.mean(\n                a[:, 2]\n                ==\n                a[:, 3]\n            ),\n\n        \"Peak-hour within +-1h (%)\":\n            100\n            *\n            np.mean(\n                np.abs(\n                    a[:, 2]\n                    -\n                    a[:, 3]\n                )\n                <= 1\n            ),\n\n        \"n_days\":\n            len(a)\n    }\n\n\n# =============================================================================\n# BLOCK BOOTSTRAP\n# =============================================================================\n\ndef block_bootstrap_ci(\n    y,\n    p,\n    block=24,\n    n_boot=1000,\n    seed=0\n):\n\n    rng = np.random.default_rng(\n        seed\n    )\n\n    n = len(y)\n\n    nb = int(\n        np.ceil(\n            n / block\n        )\n    )\n\n\n    starts = rng.integers(\n        0,\n        n - block + 1,\n        size=(\n            n_boot,\n            nb\n        )\n    )\n\n\n    ix = (\n        starts[:, :, None]\n        +\n        np.arange(block)[\n            None,\n            None,\n            :\n        ]\n    ).reshape(\n        n_boot,\n        -1\n    )[:, :n]\n\n\n    fn = {\n\n        \"MAE\":\n            lambda a, b:\n            np.mean(\n                np.abs(a - b)\n            ),\n\n        \"RMSE\":\n            lambda a, b:\n            np.sqrt(\n                np.mean(\n                    (a - b) ** 2\n                )\n            ),\n\n        \"MAPE\":\n            lambda a, b:\n            np.mean(\n                np.abs(a - b) / a\n            ) * 100\n    }\n\n\n    return {\n\n        k:\n            tuple(\n                np.percentile(\n                    [\n                        f(\n                            y[i],\n                            p[i]\n                        )\n                        for i in ix\n                    ],\n                    [2.5, 97.5]\n                )\n            )\n\n        for k, f in fn.items()\n    }\n\n\n# =============================================================================\n# DIEBOLD-MARIANO\n# =============================================================================\n\ndef diebold_mariano(\n    e_a,\n    e_b,\n    power=1,\n    hac_lags=24\n):\n\n    d = (\n        np.abs(e_a) ** power\n        -\n        np.abs(e_b) ** power\n    )\n\n\n    n = len(d)\n\n    dm = d - d.mean()\n\n    lrv = np.mean(\n        dm * dm\n    )\n\n\n    for k in range(\n        1,\n        hac_lags + 1\n    ):\n\n        lrv += (\n            2\n            *\n            (\n                1\n                -\n                k / (hac_lags + 1)\n            )\n            *\n            np.mean(\n                dm[k:]\n                *\n                dm[:-k]\n            )\n        )\n\n\n    stat = (\n        d.mean()\n        /\n        np.sqrt(\n            max(\n                lrv,\n                1e-12\n            )\n            / n\n        )\n    )\n\n\n    h = HORIZON\n\n\n    stat *= np.sqrt(\n        (\n            n\n            + 1\n            - 2 * h\n            + h * (h - 1) / n\n        )\n        / n\n    )\n\n\n    return (\n        float(stat),\n        float(\n            2\n            *\n            (\n                1\n                -\n                stats.t.cdf(\n                    abs(stat),\n                    df=n - 1\n                )\n            )\n        )\n    )\n\n\n# =============================================================================\n# 7.1 MAIN COMPARISON TABLE\n# =============================================================================\n\nrows = []\nci_rows = []\n\n\n# `preds` only ever contains actual point-forecast series (the ensemble,\n# persistence, and seasonal-naive baselines). The 95% PI lower/upper bounds\n# are kept in separate arrays (test_lower_pi / test_upper_pi) and are never\n# inserted into `preds`, so they cannot be treated as additional models in\n# the metrics tables below.\n\npoint_forecast_preds = preds.copy()\n\n\nfor name, p in point_forecast_preds.items():\n\n    m = compute_metrics(\n        y_true,\n        p,\n        y_ref=persist_pred,\n        mase_scale=mase_scale\n    )\n\n\n    m.update(\n        daily_peak_metrics(\n            dts_test,\n            y_true,\n            p\n        )\n    )\n\n\n    ci = block_bootstrap_ci(\n        y_true,\n        p\n    )\n\n\n    m.update(\n        {\n            f\"{k} 95% CI\":\n                f\"[{lo:.2f}, {hi:.2f}]\"\n\n            for k, (\n                lo,\n                hi\n            ) in ci.items()\n        }\n    )\n\n\n    rows.append(\n        {\n            \"Model\": name,\n            **m\n        }\n    )\n\n\nfull_table = pd.DataFrame(\n    rows\n).set_index(\n    \"Model\"\n)\n\n\nfull_table.to_csv(\n    f\"{OUT_DIR}/metrics_full_all_models.csv\"\n)\n\n\nmain_cols = [\n    \"MAE (MW)\",\n    \"RMSE (MW)\",\n    \"MAPE (%)\",\n    \"sMAPE (%)\",\n    \"WAPE (%)\",\n    \"R2\",\n    \"MASE\",\n    \"Theil U2 (vs persistence)\",\n    \"Skill vs persistence, MAE (%)\",\n    \"Peak MAPE (%)\"\n]\n\n\npaper_table = full_table[\n    main_cols\n    +\n    [\"MAPE 95% CI\"]\n].copy()\n\n\npaper_table.to_csv(\n    f\"{OUT_DIR}/paper_table_main.csv\"\n)\n\n\ntry:\n\n    paper_table.round(3).to_latex(\n        f\"{OUT_DIR}/paper_table_main.tex\",\n        float_format=\"%.3f\"\n    )\n\nexcept Exception as e:\n\n    print(\n        \"LaTeX export skipped:\",\n        e\n    )\n\n\n# =============================================================================\n# 7.2 PER-SEED STATISTICS\n# =============================================================================\n\nseed_rows = []\n\n\nfor r in results:\n\n    m = compute_metrics(\n        y_true,\n        to_mw(\n            r[\"test_pred\"],\n            test_t\n        ),\n        y_ref=persist_pred,\n        mase_scale=mase_scale\n    )\n\n\n    seed_rows.append(\n        {\n            \"seed\": r[\"seed\"],\n            \"best_epoch\": r[\"best_epoch\"],\n            **{\n                k: m[k]\n                for k in [\n                    \"MAE (MW)\",\n                    \"RMSE (MW)\",\n                    \"MAPE (%)\",\n                    \"sMAPE (%)\",\n                    \"R2\",\n                    \"MASE\"\n                ]\n            }\n        }\n    )\n\n\nseed_df = pd.DataFrame(\n    seed_rows\n)\n\n\nseed_summary = (\n    seed_df\n    .drop(columns=\"seed\")\n    .agg(\n        [\"mean\", \"std\"]\n    )\n    .T\n)\n\n\nseed_df.to_csv(\n    f\"{OUT_DIR}/per_seed_metrics.csv\",\n    index=False\n)\n\n\nseed_summary.to_csv(\n    f\"{OUT_DIR}/per_seed_mean_std.csv\"\n)\n\n\n# =============================================================================\n# 7.3 ERROR BREAKDOWNS\n# =============================================================================\n\np_main = preds[\n    MAIN\n]\n\n\nbrk = pd.DataFrame(\n    {\n        \"hour\":\n            dts_test.dt.hour.values,\n\n        \"cat\":\n            data[\n                \"Holiday_Category\"\n            ].astype(int)\n            .to_numpy()[test_t],\n\n        \"ram\":\n            data[\n                \"IsRamadan\"\n            ].to_numpy()[test_t],\n\n        \"y\":\n            y_true,\n\n        \"p\":\n            p_main,\n\n        \"pp\":\n            persist_pred\n    }\n)\n\n\nbrk[\"ae\"] = np.abs(\n    brk.y - brk.p\n)\n\nbrk[\"ape\"] = (\n    np.abs(\n        brk.y - brk.p\n    )\n    /\n    brk.y\n    *\n    100\n)\n\n\nbrk[\"ape_persist\"] = (\n    np.abs(\n        brk.y - brk.pp\n    )\n    /\n    brk.y\n    *\n    100\n)\n\n\nby_hour = brk.groupby(\n    \"hour\"\n).agg(\n    MAE=(\"ae\", \"mean\"),\n    MAPE=(\"ape\", \"mean\"),\n    RMSE=(\n        \"ae\",\n        lambda s:\n        np.sqrt(\n            np.mean(\n                s ** 2\n            )\n        )\n    ),\n    MAPE_persistence=(\n        \"ape_persist\",\n        \"mean\"\n    )\n)\n\n\nby_hour[\"MBE\"] = (\n    brk.p - brk.y\n).groupby(\n    brk.hour\n).mean()\n\n\nby_hour.to_csv(\n    f\"{OUT_DIR}/error_by_hour.csv\"\n)\n\n\nbrk[\"day_type\"] = brk.cat.map(\n    {\n        0:\n            \"Working day\",\n\n        1:\n            \"Weekend (Fri/Sat)\",\n\n        2:\n            \"Public holiday\"\n    }\n)\n\n\nby_type = brk.groupby(\n    \"day_type\"\n).agg(\n    hours=(\"y\", \"size\"),\n    MAE=(\"ae\", \"mean\"),\n    MAPE=(\"ape\", \"mean\"),\n    MAPE_persistence=(\n        \"ape_persist\",\n        \"mean\"\n    )\n)\n\n\nby_type.to_csv(\n    f\"{OUT_DIR}/error_by_day_type.csv\"\n)\n\n\nbrk[\"ramadan\"] = brk.ram.map(\n    {\n        0.0:\n            \"Non-Ramadan\",\n\n        1.0:\n            \"Ramadan\"\n    }\n)\n\n\nby_ram = brk.groupby(\n    \"ramadan\"\n).agg(\n    hours=(\"y\", \"size\"),\n    MAE=(\"ae\", \"mean\"),\n    MAPE=(\"ape\", \"mean\"),\n    MAPE_persistence=(\n        \"ape_persist\",\n        \"mean\"\n    )\n)\n\n\nby_ram.to_csv(\n    f\"{OUT_DIR}/error_by_ramadan.csv\"\n)\n\n\nbrk[\"load_band\"] = pd.qcut(\n    brk.y,\n    3,\n    labels=[\n        \"Low load\",\n        \"Mid load\",\n        \"High load\"\n    ]\n)\n\n\nby_load = brk.groupby(\n    \"load_band\",\n    observed=True\n).agg(\n    MAE=(\"ae\", \"mean\"),\n    MAPE=(\"ape\", \"mean\")\n)\n\n\nby_load.to_csv(\n    f\"{OUT_DIR}/error_by_load_band.csv\"\n)\n\n\n# =============================================================================\n# 7.4 DIEBOLD-MARIANO\n# =============================================================================\n\ndm_rows = []\n\n\ne_main = (\n    y_true\n    -\n    p_main\n)\n\n\nfor name, p in point_forecast_preds.items():\n\n    if name == MAIN:\n        continue\n\n\n    s1, pv1 = diebold_mariano(\n        e_main,\n        y_true - p,\n        power=1\n    )\n\n\n    s2, pv2 = diebold_mariano(\n        e_main,\n        y_true - p,\n        power=2\n    )\n\n\n    dm_rows.append(\n        {\n            \"Main model vs\":\n                name,\n\n            \"DM stat (abs err)\":\n                s1,\n\n            \"p (abs err)\":\n                pv1,\n\n            \"DM stat (sq err)\":\n                s2,\n\n            \"p (sq err)\":\n                pv2,\n\n            \"Significant @5% (abs err)\":\n                pv1 < 0.05 and s1 < 0\n        }\n    )\n\n\ndm_df = pd.DataFrame(\n    dm_rows\n)\n\n\ndm_df.to_csv(\n    f\"{OUT_DIR}/diebold_mariano.csv\",\n    index=False\n)\n\n\n# =============================================================================\n# 7.5 COMPLEXITY\n# =============================================================================\n\ncomplexity = pd.DataFrame(\n    [\n        {\n            \"n_params\":\n                results[0][\"n_params\"],\n\n            \"train_time_s_per_model (mean)\":\n                np.mean(\n                    [\n                        r[\"train_time_s\"]\n                        for r in results\n                    ]\n                ),\n\n            \"best_epoch (mean)\":\n                np.mean(\n                    [\n                        r[\"best_epoch\"]\n                        for r in results\n                    ]\n                ),\n\n            \"inference_ms_per_sample\":\n                np.mean(\n                    [\n                        r[\"infer_ms_per_sample\"]\n                        for r in results\n                    ]\n                ),\n\n            \"n_ensemble_members\":\n                N_MODELS,\n\n            \"device\":\n                str(device),\n\n            \"lstm_hidden\":\n                LSTM_HIDDEN,\n\n            \"lstm_layers\":\n                LSTM_LAYERS,\n\n            \"lstm_steps\":\n                results[0][\"model\"].n_steps\n        }\n    ]\n)\n\n\ncomplexity.to_csv(\n    f\"{OUT_DIR}/model_complexity.csv\",\n    index=False\n)\n\n\n# =============================================================================\n# 7.6 TEST PREDICTIONS\n# =============================================================================\n\npd.DataFrame(\n    {\n        \"datetime\":\n            dts_test,\n\n        \"actual_MW\":\n            y_true,\n\n        **{\n            k: v\n            for k, v in preds.items()\n        }\n    }\n).to_csv(\n    f\"{OUT_DIR}/test_predictions.csv\",\n    index=False\n)\n\n\n# =============================================================================\n# PRINT RESULTS\n# =============================================================================\n\npd.set_option(\n    \"display.width\",\n    220\n)\n\npd.set_option(\n    \"display.max_columns\",\n    50\n)\n\npd.set_option(\n    \"display.float_format\",\n    \"{:.3f}\".format\n)\n\n\nprint(\n    \"\\n\"\n    + \"=\" * 100\n    + f\"\\nTEST RESULTS \"\n      f\"(horizon = {HORIZON}h, \"\n      f\"{len(y_true)} hours, \"\n      f\"{dts_test.iloc[0]:%Y-%m-%d} \"\n      f\"-> \"\n      f\"{dts_test.iloc[-1]:%Y-%m-%d})\"\n    + \"\\n\"\n    + \"=\" * 100\n)\n\n\nprint(\n    paper_table.to_string()\n)\n\n\nprint(\n    \"\\n--- Full metrics, main model ---\"\n)\n\n\nprint(\n    full_table.loc[\n        MAIN\n    ].to_string()\n)\n\n\nprint(\n    \"\\n--- Per-seed (mean, std) ---\"\n)\n\nprint(\n    seed_summary.to_string()\n)\n\n\nprint(\n    \"\\n--- Error by day type ---\"\n)\n\nprint(\n    by_type.to_string()\n)\n\n\nprint(\n    \"\\n--- Error by Ramadan ---\"\n)\n\nprint(\n    by_ram.to_string()\n)\n\n\nprint(\n    \"\\n--- Error by load band ---\"\n)\n\nprint(\n    by_load.to_string()\n)\n\n\nprint(\n    \"\\n--- Diebold-Mariano \"\n    \"(negative = main model better) ---\"\n)\n\nprint(\n    dm_df.to_string(\n        index=False\n    )\n)\n\n\nprint(\n    \"\\n--- Complexity ---\"\n)\n\nprint(\n    complexity.to_string(\n        index=False\n    )\n)\n\n\n# =============================================================================\n# 8. FIGURES\n# =============================================================================\n\nplt.rcParams.update(\n    {\n        \"font.size\": 11,\n        \"axes.grid\": True,\n        \"grid.linestyle\": \":\",\n        \"figure.dpi\": 100\n    }\n)\n\n\nsave = lambda name: (\n    plt.tight_layout(),\n    plt.savefig(\n        f\"{OUT_DIR}/{name}.png\",\n        dpi=300\n    ),\n    plt.show()\n)\n\n\n# =============================================================================\n# 8.1 LEARNING CURVES\n# =============================================================================\n\nfig, ax = plt.subplots(\n    1,\n    2,\n    figsize=(13, 4)\n)\n\n\nfor r in results:\n\n    ax[0].plot(\n        r[\"hist\"][\"train_loss\"],\n        color=\"C0\",\n        alpha=.6\n    )\n\n    ax[0].plot(\n        r[\"hist\"][\"val_loss\"],\n        color=\"C1\",\n        alpha=.6\n    )\n\n\n    ax[1].plot(\n        r[\"hist\"][\"val_mape\"],\n        alpha=.7,\n        label=f\"seed {r['seed']}\"\n    )\n\n\nax[0].set_title(\n    \"Training (blue) / validation (orange) loss\"\n)\n\nax[0].set_xlabel(\n    \"Epoch\"\n)\n\nax[0].set_ylabel(\n    \"SmoothL1\"\n)\n\n\nax[1].set_title(\n    \"Validation MAPE\"\n)\n\nax[1].set_xlabel(\n    \"Epoch\"\n)\n\nax[1].set_ylabel(\n    \"MAPE (%)\"\n)\n\nax[1].legend()\n\n\nsave(\n    \"fig1_learning_curves\"\n)\n\n\n# =============================================================================\n# 8.2 FORECAST OVERLAYS\n# =============================================================================\n\nfig, ax = plt.subplots(\n    2,\n    1,\n    figsize=(15, 8)\n)\n\n\nn7 = min(\n    168,\n    len(y_true)\n)\n\n\nax[0].plot(\n    dts_test[:n7],\n    y_true[:n7],\n    \"k\",\n    lw=1.8,\n    label=\"Actual\"\n)\n\n\nax[0].plot(\n    dts_test[:n7],\n    p_main[:n7],\n    \"--\",\n    color=\"C3\",\n    lw=1.5,\n    label=MODEL_NAME\n)\n\n\nax[0].plot(\n    dts_test[:n7],\n    persist_pred[:n7],\n    \":\",\n    color=\"gray\",\n    label=\"Persistence\"\n)\n\n\nax[0].set_title(\n    \"Forecast vs actual, first 7 test days\"\n)\n\nax[0].set_ylabel(\n    \"Demand (MW)\"\n)\n\nax[0].legend()\n\n\nax[1].plot(\n    dts_test,\n    y_true,\n    \"k\",\n    lw=1.0,\n    label=\"Actual\"\n)\n\n\nax[1].plot(\n    dts_test,\n    p_main,\n    \"--\",\n    color=\"C3\",\n    lw=.9,\n    label=MODEL_NAME\n)\n\n\nax[1].set_title(\n    \"Full test period\"\n)\n\nax[1].set_ylabel(\n    \"Demand (MW)\"\n)\n\nax[1].legend()\n\n\nsave(\n    \"fig2_forecast_overlay\"\n)\n\n\n# =============================================================================\n# 8.2.1 95% PREDICTION INTERVAL - FIRST 7 TEST DAYS\n# =============================================================================\n\nfig, ax = plt.subplots(\n    figsize=(15, 5)\n)\n\n\nax.plot(\n    dts_test[:n7],\n    y_true[:n7],\n    \"k\",\n    lw=1.8,\n    label=\"Actual\"\n)\n\n\nax.plot(\n    dts_test[:n7],\n    test_point_forecast[:n7],\n    \"--\",\n    color=\"C3\",\n    lw=1.5,\n    label=MODEL_NAME\n)\n\n\nax.fill_between(\n    dts_test[:n7],\n    test_lower_pi[:n7],\n    test_upper_pi[:n7],\n    alpha=0.20,\n    label=\"95% Prediction Interval\"\n)\n\n\nax.set_title(\n    \"Forecast with 95% Prediction Interval, \"\n    \"first 7 test days\"\n)\n\n\nax.set_ylabel(\n    \"Demand (MW)\"\n)\n\n\nax.set_xlabel(\n    \"Datetime\"\n)\n\n\nax.legend()\n\n\nsave(\n    \"fig2_1_forecast_95_prediction_interval\"\n)\n\n\n# =============================================================================\n# 8.2.2 95% PREDICTION INTERVAL - FULL TEST PERIOD\n# =============================================================================\n\nfig, ax = plt.subplots(\n    figsize=(15, 5)\n)\n\n\nax.plot(\n    dts_test,\n    y_true,\n    \"k\",\n    lw=1.0,\n    label=\"Actual\"\n)\n\n\nax.plot(\n    dts_test,\n    test_point_forecast,\n    \"--\",\n    color=\"C3\",\n    lw=0.9,\n    label=MODEL_NAME\n)\n\n\nax.fill_between(\n    dts_test,\n    test_lower_pi,\n    test_upper_pi,\n    alpha=0.20,\n    label=\"95% Prediction Interval\"\n)\n\n\nax.set_title(\n    \"Forecast with 95% Prediction Interval, \"\n    \"full test period\"\n)\n\n\nax.set_ylabel(\n    \"Demand (MW)\"\n)\n\n\nax.set_xlabel(\n    \"Datetime\"\n)\n\n\nax.legend()\n\n\nsave(\n    \"fig2_2_full_test_95_prediction_interval\"\n)\n\n\n# =============================================================================\n# 8.3 SCATTER\n# =============================================================================\n\nplt.figure(\n    figsize=(5.5, 5.5)\n)\n\n\nplt.scatter(\n    y_true,\n    p_main,\n    s=8,\n    alpha=.4\n)\n\n\nlim = [\n    min(\n        y_true.min(),\n        p_main.min()\n    ),\n    max(\n        y_true.max(),\n        p_main.max()\n    )\n]\n\n\nplt.plot(\n    lim,\n    lim,\n    \"r--\",\n    label=\"y = x\"\n)\n\n\nplt.xlabel(\n    \"Actual (MW)\"\n)\n\nplt.ylabel(\n    \"Predicted (MW)\"\n)\n\n\nplt.title(\n    f\"Actual vs predicted \"\n    f\"(R$^2$={full_table.loc[MAIN,'R2']:.4f})\"\n)\n\nplt.legend()\n\n\nsave(\n    \"fig3_scatter\"\n)\n\n\n# =============================================================================\n# 8.4 RESIDUAL DIAGNOSTICS\n# =============================================================================\n\nres = (\n    y_true\n    -\n    p_main\n)\n\n\nfig, ax = plt.subplots(\n    2,\n    2,\n    figsize=(13, 8)\n)\n\n\nax[0, 0].plot(\n    dts_test,\n    res,\n    lw=.7\n)\n\nax[0, 0].axhline(\n    0,\n    color=\"r\",\n    ls=\"--\"\n)\n\nax[0, 0].set_title(\n    \"Residuals over time (MW)\"\n)\n\n\nax[0, 1].hist(\n    res,\n    bins=40,\n    edgecolor=\"k\"\n)\n\nax[0, 1].axvline(\n    0,\n    color=\"r\",\n    ls=\"--\"\n)\n\nax[0, 1].set_title(\n    \"Residual distribution\"\n)\n\n\nstats.probplot(\n    res,\n    dist=\"norm\",\n    plot=ax[1, 0]\n)\n\nax[1, 0].set_title(\n    \"Normal Q-Q\"\n)\n\n\nL = min(\n    72,\n    len(res) // 3\n)\n\n\nacf = [\n    np.corrcoef(\n        res[:-k],\n        res[k:]\n    )[0, 1]\n    for k in range(\n        1,\n        L + 1\n    )\n]\n\n\nax[1, 1].bar(\n    range(1, L + 1),\n    acf\n)\n\n\nband = (\n    1.96\n    /\n    np.sqrt(\n        len(res)\n    )\n)\n\n\nax[1, 1].axhline(\n    band,\n    color=\"r\",\n    ls=\"--\"\n)\n\nax[1, 1].axhline(\n    -band,\n    color=\"r\",\n    ls=\"--\"\n)\n\n\nax[1, 1].set_title(\n    \"Residual autocorrelation (95% band)\"\n)\n\nax[1, 1].set_xlabel(\n    \"Lag (h)\"\n)\n\n\nsave(\n    \"fig4_residual_diagnostics\"\n)\n\n\n# =============================================================================\n# 8.5 ERROR BY HOUR + DAY TYPE\n# =============================================================================\n\nfig, ax = plt.subplots(\n    1,\n    2,\n    figsize=(14, 4.5)\n)\n\n\nax[0].plot(\n    by_hour.index,\n    by_hour[\"MAPE\"],\n    \"o-\",\n    label=MODEL_NAME\n)\n\n\nax[0].plot(\n    by_hour.index,\n    by_hour[\"MAPE_persistence\"],\n    \"s--\",\n    color=\"gray\",\n    label=\"Persistence\"\n)\n\n\nax[0].set_xticks(\n    range(0, 24)\n)\n\nax[0].set_xlabel(\n    \"Hour of day\"\n)\n\nax[0].set_ylabel(\n    \"MAPE (%)\"\n)\n\nax[0].set_title(\n    \"MAPE by hour of day\"\n)\n\nax[0].legend()\n\n\nby_type[\n    [\n        \"MAPE\",\n        \"MAPE_persistence\"\n    ]\n].plot.bar(\n    ax=ax[1],\n    rot=0\n)\n\n\nax[1].set_ylabel(\n    \"MAPE (%)\"\n)\n\nax[1].set_title(\n    \"MAPE by day type\"\n)\n\nax[1].set_xlabel(\n    \"\"\n)\n\n\nsave(\n    \"fig5_error_by_hour_and_daytype\"\n)\n\n\n# =============================================================================\n# 8.6 AVERAGE DAILY LOAD PROFILE\n# =============================================================================\n\nplt.figure(\n    figsize=(9, 4)\n)\n\n\nplt.plot(\n    brk.groupby(\"hour\").y.mean(),\n    \"k\",\n    lw=2,\n    label=\"Actual (mean)\"\n)\n\n\nplt.plot(\n    brk.groupby(\"hour\").p.mean(),\n    \"--\",\n    color=\"C3\",\n    lw=2,\n    label=\"Predicted (mean)\"\n)\n\n\nplt.xticks(\n    range(24)\n)\n\nplt.xlabel(\n    \"Hour of day\"\n)\n\nplt.ylabel(\n    \"Demand (MW)\"\n)\n\n\nplt.title(\n    \"Average daily load profile - test period\"\n)\n\nplt.legend()\n\n\nsave(\n    \"fig6_daily_profile\"\n)\n\n\n# =============================================================================\n# 9. SAVE RUN CONFIG\n# =============================================================================\n\njson.dump(\n    {\n        \"model\":\n            MODEL_NAME,\n\n        \"seed\":\n            SEED,\n\n        \"seq_len\":\n            SEQ_LEN,\n\n        \"horizon\":\n            HORIZON,\n\n        \"val_days\":\n            VAL_DAYS,\n\n        \"test_days\":\n            TEST_DAYS,\n\n        \"n_models\":\n            N_MODELS,\n\n        \"batch_size\":\n            BATCH_SIZE,\n\n        \"lr\":\n            LR,\n\n        \"weight_decay\":\n            WEIGHT_DECAY,\n\n        \"max_epochs\":\n            MAX_EPOCHS,\n\n        \"patience\":\n            PATIENCE,\n\n        # BiLSTM settings\n        \"lstm_hidden\":\n            LSTM_HIDDEN,\n\n        \"lstm_layers\":\n            LSTM_LAYERS,\n\n        \"lstm_dropout\":\n            LSTM_DROPOUT,\n\n        \"lstm_steps\":\n            results[0][\"model\"].n_steps,\n\n        \"use_raw_station_weather\":\n            USE_RAW_STATION_WEATHER,\n\n        \"use_target_weather\":\n            USE_TARGET_WEATHER,\n\n        \"n_seq_features\":\n            N_SEQ_FEAT,\n\n        \"n_known_features\":\n            N_KNOWN,\n\n        \"lev_scale\":\n            LEV_SCALE,\n\n        \"y_scale\":\n            Y_SCALE,\n\n        \"mase_scale_MW\":\n            mase_scale,\n\n        # Prediction interval settings\n        \"prediction_interval\":\n            True,\n\n        \"prediction_interval_confidence\":\n            PI_CONFIDENCE,\n\n        \"prediction_interval_radius_MW\":\n            PI_RADIUS,\n\n        \"prediction_interval_coverage_test\":\n            pi_coverage\n    },\n\n    open(\n        f\"{OUT_DIR}/run_config.json\",\n        \"w\"\n    ),\n\n    indent=2\n)\n\n\nprint(\n    f\"\\nDone. All tables / figures / predictions \"\n    f\"saved in: {OUT_DIR}\"\n)\n\nprint(\n    \"\\nModel architecture:\"\n)\n\nprint(\n    \"Input → CNN → BiLSTM → Final Fwd/Bwd Hidden \"\n    \"→ Known Target-Hour Branch → Forecast\"\n)\n\nprint(\n    f\"\\nLSTM hidden size (per direction) = {LSTM_HIDDEN}\"\n)\n\nprint(\n    f\"LSTM layers = {LSTM_LAYERS}\"\n)\n\nprint(\n    f\"LSTM steps = {results[0]['model'].n_steps}\"\n)\n","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-10-02T14:42:28.628779Z","iopub.execute_input":"2026-10-02T14:42:28.629099Z","iopub.status.idle":"2026-10-02T15:16:08.6589Z","shell.execute_reply.started":"2026-10-02T14:42:28.629068Z","shell.execute_reply":"2026-10-02T15:16:08.658241Z"}},"outputs":[{"name":"stdout","text":"Devi